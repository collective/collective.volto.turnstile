<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:zcml="http://namespaces.zope.org/zcml"
    i18n_domain="collective.volto.turnstile"
    >

  <configure zcml:condition="installed AccessControl.security">

    <!-- Add ManageCloudflareTurnstileSettings permission -->
    <permission
        id="volto.turnstile.ManageCloudflareTurnstileSettings"
        title="volto.turnstile: Manage Cloudflare Turnstile Settings"
        />

  </configure>

  <!-- -*- extra stuff goes here -*- -->

</configure>
